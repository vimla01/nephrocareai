# ==========================================================
# NephroCare Environment Variables Template
# Copy this file to a new file named '.env' and fill in your actual credentials.
# DO NOT commit '.env' to version control (GitHub).
# ==========================================================

# ─── API Configuration ───
API_PORT=8000
FRONTEND_PORT=5175
VITE_API_URL=http://127.0.0.1:8000

# ─── Gemini AI Configurations ───
# Google Gemini API key for diagnostics, food scanner, and visual analysis
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Gemini API key used specifically by the patient chatbot
GEMINI_API_CHATBOT=YOUR_GEMINI_API_KEY_HERE

# ─── Google OAuth (Google Sign-In) ───
# Get this from Google Cloud Console (credentials page)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com

# ─── Twilio WhatsApp Alert Credentials ───
# Get these from your Twilio Console page
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Twilio sandbox WhatsApp sender (typically: whatsapp:+14155238886)
TWILIO_FROM_NUMBER=whatsapp:+14155238886

# ─── PostgreSQL Database Connection ───
# Connection string for your local PostgreSQL or Supabase instance
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
